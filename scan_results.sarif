{"$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"AntiFine IaC Scanner","semanticVersion":"1.0.0","rules":[{"id":"AF-IAC-AC2C7D","shortDescription":{"text":"Insecure Configuration (USER root) in Dockerfile.test"},"defaultConfiguration":{"level":"warning"},"properties":{"frameworks":["CIS Docker Benchmark 4.1","NIST SP 800-190 §3.3.1","PCI-DSS 4.0 Req 2.2.4"],"tags":["CIS Docker Benchmark 4.1","NIST SP 800-190 §3.3.1","PCI-DSS 4.0 Req 2.2.4"]}},{"id":"AF-IAC-D28BD6","shortDescription":{"text":"Insecure Configuration (Missing HEALTHCHECK) in Dockerfile.test"},"defaultConfiguration":{"level":"note"},"properties":{"frameworks":["CIS Docker Benchmark 4.6","NIST SP 800-190 §3.3.4"],"tags":["CIS Docker Benchmark 4.6","NIST SP 800-190 §3.3.4"]}},{"id":"AF-IAC-719A2B","shortDescription":{"text":"Informational: USER root in intermediate build stage (stage:builder) in Dockerfile.advanced_test -- acceptable for toolchain/package-installation stages"},"defaultConfiguration":{"level":"note"},"properties":{"frameworks":["CIS Docker Benchmark 4.1 (Informational -- intermediate stage only)","NIST SP 800-190 §3.3.1"],"tags":["CIS Docker Benchmark 4.1 (Informational -- intermediate stage only)","NIST SP 800-190 §3.3.1"]}},{"id":"AF-IAC-BE7F19","shortDescription":{"text":"Unpinned Image Tag (latest or missing) in Dockerfile.advanced_test [final stage]"},"defaultConfiguration":{"level":"warning"},"properties":{"frameworks":["CIS Docker Benchmark 4.3","NIST SP 800-190 §3.3.2"],"tags":["CIS Docker Benchmark 4.3","NIST SP 800-190 §3.3.2"]}},{"id":"AF-IAC-87F9CA","shortDescription":{"text":"Hardcoded Secret in ENV Instruction in Dockerfile.advanced_test"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["CIS Docker Benchmark 4.7","CWE-798 (Use of Hard-coded Credentials)","ISO 27001 A.8.24"],"tags":["CIS Docker Benchmark 4.7","CWE-798 (Use of Hard-coded Credentia