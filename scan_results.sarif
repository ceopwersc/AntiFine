","CWE-312 (Cleartext Storage of Sensitive Information)","ISO 27001 A.8.24","NIST SP 800-190 §3.3.1"]}},{"id":"AF-IAC-2CED3F","shortDescription":{"text":"Insecure Configuration (Missing USER) in Dockerfile.advanced_test"},"defaultConfiguration":{"level":"warning"},"properties":{"frameworks":["CIS Docker Benchmark 4.1","NIST SP 800-190 §3.3.1","PCI-DSS 4.0 Req 2.2.4"],"tags":["CIS Docker Benchmark 4.1","NIST SP 800-190 §3.3.1","PCI-DSS 4.0 Req 2.2.4"]}},{"id":"AF-IAC-282B08","shortDescription":{"text":"Exact Vendor Match (GitHub Personal Access Token) in k8s_test.yaml [value]"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["CIS Docker Benchmark 4.7","CWE-798 (Use of Hard-coded Credentials)","ISO 27001 A.8.24","NIST SP 800-190 §3.3.1"],"tags":["CIS Docker Benchmark 4.7","CWE-798 (Use of Hard-coded Credentials)","ISO 27001 A.8.24","NIST SP 800-190 §3.3.1"]}},{"id":"AF-IAC-BF2581","shortDescription":{"text":"Host Namespace Exposure (hostPID, hostIPC, hostNetwork) in k8s_test.yaml"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["Unmapped"],"tags":["Unmapped"]}},{"id":"AF-IAC-AE864D","shortDescription":{"text":"Privileged Container (malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["CIS Kubernetes Benchmark 5.2.1","NIST SP 800-190 §3.4.4","PCI-DSS 4.0 Req 2.2.4"],"tags":["CIS Kubernetes Benchmark 5.2.1","NIST SP 800-190 §3.4.4","PCI-DSS 4.0 Req 2.2.4"]}},{"id":"AF-IAC-674D70","shortDescription":{"text":"Privilege Escalation Allowed (malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["Unmapped"],"tags":["Unmapped"]}},{"id":"AF-IAC-D810EE","shortDescription":{"text":"Container May Run As Root (malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["Unmapped"],"tags":["Unmapped"]}},{"id":"AF-IAC-ED2A12","shortDescription":{"text":"Writable Root Filesystem (malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"warning"},"properties":{"frameworks":["Unmapped"],"tags":["Unmapped"]}},{"id":"AF-IAC-0978A9","shortDescription":{"text":"Insecure Capabilities (Missing drop ALL for malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["Unmapped"],"tags":["Unmapped"]}},{"id":"AF-IAC-809FAB","shortDescription":{"text":"Dangerous Capabilities Added (SYS_ADMIN, NET_ADMIN for malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"error"},"properties":{"frameworks":["Unmapped"],"tags":["Unmapped"]}},{"id":"AF-IAC-318C8E","shortDescription":{"text":"Missing Seccomp Profile (malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"warning"},"properties":{"frameworks":["Unmapped"],"tags":["Unmapped"]}},{"id":"AF-IAC-096955","shortDescription":{"text":"Missing Resource Limits (malicious-container) in k8s_test.yaml"},"defaultConfiguration":{"level":"warning"},"properties":{"frameworks":["CIS Kubernetes Benchmark 5.2.4","NIST SP 800-190 §3.4.3"],"tags":["CIS Kubernetes Benchmark 5.2.4","NIST SP 800-190 §3.4.3"]}}]}},"results":[{"ruleId":"AF-IAC-AC2C7D","message":{"text":"Insecure Configuration (USER root) in Dockerfile.test"},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"# Create a dedicated non-root user and switch to it\nRUN groupadd -r appuser && useradd -r -g appuser appuser\nUSER appuser"}},{"ruleId":"AF-IAC-D28BD6","message":{"text":"Insecure Configuration (Missing HEALTHCHECK) in Dockerfile.test"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \\\n  CMD curl -f http://localhost:8000/health || exit 1"}},{"ruleId":"AF-IAC-719A2B","message":{"text":"Informational: USER root in intermediate build stage (stage:builder) in Dockerfile.advanced_test -- acceptable for toolchain/package-installation stages"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"# No immediate action required for intermediate (builder) stages.\n# Ensure the FINAL stage switches to a non-root user:\n\nFROM base-image AS builder\n# root operations here are fine for toolchain setup\nRUN apt-get install -y build-essential\n\nFROM python:3.12-slim\nCOPY --from=builder /app /app\n# Switch to non-root before the ENTRYPOINT\nRUN groupadd -r appuser && useradd -r -g appuser appuser\nUSER appuser\nENTRYPOINT [\"python\", \"app.py\"]"}},{"ruleId":"AF-IAC-BE7F19","message":{"text":"Unpinned Image Tag (latest or missing) in Dockerfile.advanced_test [final stage]"},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"# Pin to an exact digest for full supply-chain integrity\nFROM python:3.12.4-slim-bookworm@sha256:<digest>\n\n# At minimum, pin to a specific minor version\nFROM python:3.12.4-slim-bookworm"}},{"ruleId":"AF-IAC-87F9CA","message":{"text":"Hardcoded Secret in ENV Instruction in Dockerfile.advanced_test"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"# Remove the ENV secret entirely from the Dockerfile.\n# Option 1: Docker BuildKit secrets (build-time only, never stored in layer)\n# syntax=docker/dockerfile:1\nRUN --mount=type=secret,id=mysecret cat /run/secrets/mysecret\n\n# Option 2: Inject at runtime via environment variable\n# docker run -e MY_SECRET=$MY_SECRET myimage\n\n# Option 3: Use a secrets manager (Vault, AWS Secrets Manager)\n# and fetch in the entrypoint script."}},{"ruleId":"AF-IAC-87F9CA","message":{"text":"Hardcoded Secret in ENV Instruction in Dockerfile.advanced_test"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"# Remove the ENV secret entirely from the Dockerfile.\n# Option 1: Docker BuildKit secrets (build-time only, never stored in layer)\n# syntax=docker/dockerfile:1\nRUN --mount=type=secret,id=mysecret cat /run/secrets/mysecret\n\n# Option 2: Inject at runtime via environment variable\n# docker run -e MY_SECRET=$MY_SECRET myimage\n\n# Option 3: Use a secrets manager (Vault, AWS Secrets Manager)\n# and fetch in the entrypoint script."}},{"ruleId":"AF-IAC-68EBB9","message":{"text":"Insecure Configuration (USER root) in Dockerfile.advanced_test"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"# Create a dedicated non-root user and switch to it\nRUN groupadd -r appuser && useradd -r -g appuser appuser\nUSER appuser"}},{"ruleId":"AF-IAC-2A38FC","message":{"text":"Insecure Configuration (Missing HEALTHCHECK) in Dockerfile.advanced_test"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \\\n  CMD curl -f http://localhost:8000/health || exit 1"}},{"ruleId":"AF-IAC-9A5262","message":{"text":"Informational: USER root in intermediate build stage (stage:builder) in Dockerfile.multistage_compliant -- acceptable for toolchain/package-installation stages"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"project-root"}}}],"properties":{"remediation":"# No immediate action required for intermediate (builder) stages.\n# Ensure the FINAL stage switches to a non-root user:\n\nFROM base-image AS builder\n# root operations here are fine for toolchain setup\nRUN apt-get install -y build-essential\n\nFROM python:3.12-slim\nCOPY --from=builder /app /app\n# Switch to non-root before the ENTRYPOINT\nRUN groupadd -r appuser && useradd -r -g appuser appuser\nUSER appuser\nENTRYPOINT [\"python\", \"app.py\"]"}},{"ruleId":"AF-IAC-719A2B","message":{"text":"Informational: USER root in intermediate build stage (stage:builder) in Dockerfile.advanced_test -- acceptable for toolchain/package-installation stages"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile.advanced_test"}}}],"properties":{"remediation":"# No immediate action required for intermediate (builder) stages.\n# Ensure the FINAL stage switches to a non-root user:\n\nFROM base-image AS builder\n# root operations here are fine for toolchain setup\nRUN apt-get install -y build-essential\n\nFROM python:3.12-slim\nCOPY --from=builder /app /app\n# Switch to non-root before the ENTRYPOINT\nRUN groupadd -r appuser && useradd -r -g appuser appuser\nUSER appuser\nENTRYPOINT [\"python\", \"app.py\"]"}},{"ruleId":"AF-IAC-A324AE","message":{"text":"Exact Vendor Match (AWS Secret Access Key) in Dockerfile.advanced_test [AWS_SECRET_ACCESS_KEY]"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile.advanced_test"}}}],"properties":{"remediation":"Revoke token immediately and inject via external secret manager (e.g., AWS Secrets Manager, HashiCorp Vault)."}},{"ruleId":"AF-IAC-B5F7D9","message":{"text":"Statistical Entropy (Shannon H >= 3.0) in Dockerfile.advanced_test [HIGH_ENTROPY_TOKEN=... H=3.67]"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile.advanced_test"}}}],"properties":{"remediation":"# Remove the high-entropy value from the configuration file.\n# Use a secrets manager to inject secrets at runtime:\n\n# Docker BuildKit (build-time, never stored in layer):\n# syntax=docker/dockerfile:1\nRUN --mount=type=secret,id=my_secret,target=/run/secrets/my_secret \\\n    cat /run/secrets/my_secret\n\n# Kubernetes: use a Secret object and reference via envFrom\n# envFrom:\n#   - secretRef:\n#       name: my-app-secret\n\n# Terraform: use AWS Secrets Manager or Vault provider\ndata \"aws_secretsmanager_secret_version\" \"my_secret\" {\n  secret_id = \"my-app/secret\"\n}"}},{"ruleId":"AF-IAC-2CED3F","message":{"text":"Insecure Configuration (Missing USER) in Dockerfile.advanced_test"},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile.advanced_test"}}}],"properties":{"remediation":"# Add before the ENTRYPOINT/CMD instruction\nRUN groupadd -r appuser && useradd -r -g appuser appuser\nUSER appuser"}},{"ruleId":"AF-IAC-2A38FC","message":{"text":"Insecure Configuration (Missing HEALTHCHECK) in Dockerfile.advanced_test"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile.advanced_test"}}}],"properties":{"remediation":"HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \\\n  CMD curl -f http://localhost:8000/health || exit 1"}},{"ruleId":"AF-IAC-282B08","message":{"text":"Exact Vendor Match (GitHub Personal Access Token) in k8s_test.yaml [value]"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"Revoke token immediately and inject via external secret manager (e.g., AWS Secrets Manager, HashiCorp Vault)."}},{"ruleId":"AF-IAC-BF2581","message":{"text":"Host Namespace Exposure (hostPID, hostIPC, hostNetwork) in k8s_test.yaml"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"No automated remediation available. Review manually."}},{"ruleId":"AF-IAC-AE864D","message":{"text":"Privileged Container (malicious-container) in k8s_test.yaml"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"# In your Pod spec, remove 'privileged: true' and apply least-privilege\nsecurityContext:\n  allowPrivilegeEscalation: false\n  runAsNonRoot: true\n  readOnlyRootFilesystem: true\n  capabilities:\n    drop:\n      - ALL"}},{"ruleId":"AF-IAC-674D70","message":{"text":"Privilege Escalation Allowed (malicious-container) in k8s_test.yaml"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"No automated remediation available. Review manually."}},{"ruleId":"AF-IAC-D810EE","message":{"text":"Container May Run As Root (malicious-container) in k8s_test.yaml"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"No automated remediation available. Review manually."}},{"ruleId":"AF-IAC-ED2A12","message":{"text":"Writable Root Filesystem (malicious-container) in k8s_test.yaml"},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"No automated remediation available. Review manually."}},{"ruleId":"AF-IAC-0978A9","message":{"text":"Insecure Capabilities (Missing drop ALL for malicious-container) in k8s_test.yaml"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"No automated remediation available. Review manually."}},{"ruleId":"AF-IAC-809FAB","message":{"text":"Dangerous Capabilities Added (SYS_ADMIN, NET_ADMIN for malicious-container) in k8s_test.yaml"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"No automated remediation available. Review manually."}},{"ruleId":"AF-IAC-318C8E","message":{"text":"Missing Seccomp Profile (malicious-container) in k8s_test.yaml"},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"No automated remediation available. Review manually."}},{"ruleId":"AF-IAC-096955","message":{"text":"Missing Resource Limits (malicious-container) in k8s_test.yaml"},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"k8s_test.yaml"}}}],"properties":{"remediation":"resources:\n  requests:\n    memory: \"128Mi\"\n    cpu: \"100m\"\n  limits:\n    memory: \"256Mi\"\n    cpu: \"500m\""}}]}]}